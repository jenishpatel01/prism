# PRISM settings. Copy this file to .env.local and fill in the values.
# Never commit .env.local. On Vercel, add the same names under
# Project → Settings → Environment Variables, then redeploy.
# Open /app/setup in the running app to check each one.

# ── 1. GitHub sign-in ───────────────────────────────────────────────
# From your GitHub OAuth app (github.com/settings/developers → OAuth Apps).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Any random text of at least 32 characters. Encrypts the sign-in cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Optional. The public URL of the app, if it differs from what the browser uses
# (for example behind a proxy). Example: https://prism-yourname.vercel.app
APP_URL=

# ── 2. Database (Supabase Postgres) ─────────────────────────────────
# Supabase → your project → Connect → "Transaction pooler" connection string
# (port 6543), with your database password filled in.
DATABASE_URL=

# ── 3. Claude ───────────────────────────────────────────────────────
# From console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
# Free alternative (no billing): a key from aistudio.google.com/apikey.
# Used only when ANTHROPIC_API_KEY is empty. GEMINI_MODEL is optional.
GEMINI_API_KEY=
GEMINI_MODEL=

# ── Optional: higher GitHub limits for signed-out analyses ──────────
# A fine-grained token with read-only access to public repositories.
GITHUB_TOKEN=
